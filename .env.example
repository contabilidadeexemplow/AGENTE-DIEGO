# O ROBÔ DO AGRO FÁCIL, como cliente da PONTE. Valores reais só no Render.

# Endereço da PONTE SEFAZ que publicou este cliente (sem barra no fim).
PONTE_URL=https://ponte-sefaz.vercel.app

# Chave de escopo "robo" deste cliente na PONTE. É ela que abre a senha do SIARE
# de cada produtor no cofre da PONTE — por isso só existe aqui, no Render.
PONTE_CHAVE_ROBO=

# O segredo que o servidor do SITE manda no cabeçalho x-agro-facil-segredo.
# A PONTE o calcula a partir da chave do site; sem ele a API não abre para ninguém.
SEGREDO_DO_SITE=

# O "Acordar agora" do painel da PONTE chama GET /acordar/<PING_SEGREDO>.
# O mesmo valor fica gravado na PONTE (ela sorteia e grava ao criar o serviço).
PING_SEGREDO=

# Na internet (o Render já define RENDER=1 sozinho).
NA_NUVEM=1
